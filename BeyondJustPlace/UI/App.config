<configuration>

	<!-- ========================================= -->
	<!-- APPLICATION SETTINGS -->
	<!-- ========================================= -->
	<appSettings>

		<!-- HOTEL INFORMATION -->
		<add key="HotelName" value="Beyond Just Place" />
		<add key="HotelAddress" value="Caloocan, Balayan, Batangas" />
		<add key="HotelPhone" value="0992 642 2997" />
		<add key="HotelEmail" value="hernandezbijay84@gmail.com" />
		<add key="HotelTIN" value="12345" />

		<!-- EMAILJS -->
		<add key="EmailJsServiceId" value="service_gzunt5g" />
		<add key="EmailJsTemplateId" value="template_v9cf4w7" />
		<add key="EmailJsPublicKey" value="HOpHUFwhh-6WO_eZZ" />

		<!-- Leave blank unless specifically required -->
