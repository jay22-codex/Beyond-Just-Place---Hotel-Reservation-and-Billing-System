	</appSettings>

	<!-- ========================================= -->
	<!-- LOCAL DATABASE -->
	<!-- ========================================= -->
	<connectionStrings>

		<add name="HotelDB"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=BeyondJustPlaceDB;Integrated Security=True;MultipleActiveResultSets=True;Connect Timeout=30;"
			 providerName="System.Data.SqlClient" />

	</connectionStrings>

	<!-- ========================================= -->
	<!-- .NET FRAMEWORK -->
